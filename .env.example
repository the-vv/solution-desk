# Copy to .env on the VM (next to docker-compose.yml). Never commit the real .env.

# Docker Hub namespace the CI pushes to, e.g. myuser
DOCKERHUB_USERNAME=
IMAGE_TAG=latest

# Host address and port where the web container listens. Point your reverse proxy here.
# Use 127.0.0.1 if the proxy runs on the same host.
WEB_BIND_ADDRESS=
WEB_PORT=

# Public URL users open, without a trailing slash, e.g. https://desk.example.com
PUBLIC_URL=

# Google OAuth client. Redirect URI to register: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# At least 32 random characters:  openssl rand -base64 48
JWT_SECRET=

# Database password for the bundled Postgres:  openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
