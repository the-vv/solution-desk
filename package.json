{
  "name": "solution-desk",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web start",
    "build": "pnpm -r build",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:migrate": "pnpm --filter api prisma:migrate:dev"
  }
}
